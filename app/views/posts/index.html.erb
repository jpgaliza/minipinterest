<% content_for :title, "Posts" %>

<div class="container py-5">
  <div class="page-heading mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
      <div>
        <p class="eyebrow mb-2">Inspire e descubra</p>
        <h1 class="page-title mb-3">Ideias para guardar.</h1>
        <p class="page-copy mb-0">Uma coleção de referências, descobertas e pequenos momentos compartilhados.</p>
      </div>
      <%= link_to new_post_path, class: "btn btn-danger px-4" do %>
        <i class="bi bi-plus-lg me-1"></i> Novo post
      <% end %>
    </div>
  </div>

  <% if @posts.any? %>
    <div id="posts" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      <% @posts.each do |post| %>
        <div class="col">
          <%= link_to post, class: "text-decoration-none text-reset" do%>
            <article class="card h-100 shadow-sm post-card">
              <% if post.image.attached? %>
                <%= image_tag post.image, class: "card-img-top post-card-image" %>
              <% else %>
                <div class="d-flex align-items-center justify-content-center post-card-placeholder" style="height: 220px;">
                  Sem imagem
                </div>
              <% end %>

              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= post.title %></h5>
                <p class="card-text text-secondary"><%= truncate(post.description.to_s, length: 120) %></p>
                <div class="d-flex gap-2 mt-auto post-meta">
                  <i class="bi bi-person-fill"></i>
                  <span><%= post.user.username %></span>
                </div>
                <div class="mt-3">
                  <span class="text-danger small fw-semibold">Ver post <i class="bi bi-arrow-up-right"></i></span>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-light border text-center">
      Nenhum post cadastrado ainda.
    </div>
  <% end %>
</div>