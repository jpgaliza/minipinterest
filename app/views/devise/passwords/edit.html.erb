<div class="auth-page">
  <div class="auth-panel p-4 p-md-5">
    <p class="eyebrow mb-2">Acesso</p>
    <h1 class="h2 mb-4">Criar nova senha</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <%= f.label :password, "Nova senha" %>
    <% if @minimum_password_length %>
      <p class="form-hint"><em><%= @minimum_password_length %> caracteres no mínimo</em></p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirmar nova senha" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="actions">
    <%= f.submit "Alterar senha" %>
  </div>
<% end %>
    <div class="auth-links"><%= render "devise/shared/links" %></div>
  </div>
</div>
