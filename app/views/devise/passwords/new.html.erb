<div class="auth-page">
  <div class="auth-panel p-4 p-md-5">
    <p class="eyebrow mb-2">Acesso</p>
    <h1 class="h2 mb-3">Recuperar senha</h1>
    <p class="page-copy mb-4">Enviaremos instruções para o seu e-mail.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email, "E-mail" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="actions">
    <%= f.submit "Enviar instruções" %>
  </div>
<% end %>
    <div class="auth-links"><%= render "devise/shared/links" %></div>
  </div>
</div>
