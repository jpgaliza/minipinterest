<div class="auth-page">
  <div class="auth-panel p-4 p-md-5">
    <p class="eyebrow mb-2">Bem-vindo de volta</p>
    <h1 class="h2 mb-4">Entrar</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.label :email, "E-mail" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password, "Senha" %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field remember-field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Lembrar de mim" %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Entrar" %>
  </div>
<% end %>
    <div class="auth-links"><%= render "devise/shared/links" %></div>
  </div>
</div>
